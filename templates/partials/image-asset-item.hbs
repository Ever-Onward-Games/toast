{{!-- Image Asset Item --}}
<div class="asset-item image-item" data-category="image">
  <div class="asset-thumbnail">
    <img src="{{thumbnail}}" alt="{{name}}" loading="lazy">
    {{#if animated}}
      <span class="animated-badge" title="Animated image">
        <i class="fas fa-film"></i> GIF
      </span>
    {{/if}}
  </div>
  <div class="asset-info">
    <div class="asset-name">{{name}}</div>
    <div class="asset-meta">
      {{#if animated}}
        <span class="animated-indicator">
          <i class="fas fa-film"></i> Animated
        </span>
      {{/if}}
      {{#if size}}
        <span class="asset-size">{{size}}</span>
      {{/if}}
    </div>
  </div>
  <div class="asset-actions">
    <button type="button" class="image-preview-btn" data-path="{{path}}" title="Preview">
      <i class="fas fa-eye"></i>
    </button>
    <button type="button" class="use-asset-btn" data-path="{{path}}" data-type="image" title="Copy code">
      <i class="fas fa-code"></i>
    </button>
  </div>
</div>

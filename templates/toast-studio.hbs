<form class="toast-studio-window">
  {{!-- Tab Navigation --}}
  <nav class="tabs" data-group="toast-studio-tabs">
    {{#each tabs}}
      <a class="tab {{#if active}}active{{/if}} {{#if disabled}}disabled{{/if}}" data-tab="{{id}}">
        <i class="{{icon}}"></i> {{label}}
      </a>
    {{/each}}
  </nav>

  {{!-- Tab Content --}}
  <section class="tab-content">
    {{!-- Assets Tab --}}
    <div class="tab-panel {{#if tabs.assets.active}}active{{/if}}" data-tab="assets">
      <div class="assets-container">
        <div class="assets-toolbar">
          <input type="text" class="asset-search" placeholder="Search assets...">
          <select class="asset-filter">
            <option value="all">All Categories</option>
            <option value="announcer">Announcers</option>
            <option value="custom">Custom</option>
          </select>
          <button type="button" class="refresh-assets-btn">
            <i class="fas fa-sync"></i> Refresh
          </button>
        </div>

        <div class="assets-content">
          {{!-- Audio Files Section --}}
          <section class="asset-section">
            <h3><i class="fas fa-volume-up"></i> Audio Files</h3>
            <div class="asset-list audio-list">
              {{#if assets.audioFiles.length}}
                {{#each assets.audioFiles}}
                  <div class="asset-item audio-item" data-category="{{category}}">
                    <div class="asset-icon">
                      <i class="fas fa-music"></i>
                    </div>
                    <div class="asset-info">
                      <div class="asset-name">{{name}}</div>
                      <div class="asset-meta">
                        <span class="asset-category">{{category}}</span>
                        {{#if size}}
                          <span class="asset-size">{{size}}</span>
                        {{/if}}
                      </div>
                    </div>
                    <div class="asset-actions">
                      <button type="button" class="audio-preview-btn" data-path="{{path}}" title="Preview">
                        <i class="fas fa-play"></i>
                      </button>
                      <button type="button" class="use-asset-btn" data-path="{{path}}" data-type="audio" title="Copy code">
                        <i class="fas fa-code"></i>
                      </button>
                    </div>
                  </div>
                {{/each}}
              {{else}}
                <div class="empty-state">
                  <i class="fas fa-music"></i>
                  <p>No audio files found</p>
                </div>
              {{/if}}
            </div>
          </section>

          {{!-- Image Files Section --}}
          <section class="asset-section">
            <h3><i class="fas fa-image"></i> Image Files</h3>
            <div class="asset-list image-list">
              {{#if assets.imageFiles.length}}
                {{#each assets.imageFiles}}
                  <div class="asset-item image-item" data-category="image">
                    <div class="asset-thumbnail">
                      <img src="{{thumbnail}}" alt="{{name}}" loading="lazy">
                    </div>
                    <div class="asset-info">
                      <div class="asset-name">{{name}}</div>
                      <div class="asset-meta">
                        {{#if size}}
                          <span class="asset-size">{{size}}</span>
                        {{/if}}
                      </div>
                    </div>
                    <div class="asset-actions">
                      <button type="button" class="image-preview-btn" data-path="{{path}}" title="Preview">
                        <i class="fas fa-eye"></i>
                      </button>
                      <button type="button" class="use-asset-btn" data-path="{{path}}" data-type="image" title="Copy code">
                        <i class="fas fa-code"></i>
                      </button>
                    </div>
                  </div>
                {{/each}}
              {{else}}
                <div class="empty-state">
                  <i class="fas fa-image"></i>
                  <p>No image files found</p>
                </div>
              {{/if}}
            </div>
          </section>
        </div>
      </div>
    </div>

    {{!-- Packages Tab --}}
    <div class="tab-panel {{#if tabs.packages.active}}active{{/if}}" data-tab="packages">
      <div class="packages-container">
        <div class="packages-header">
          <h2>Toast Packages</h2>
          <p class="coming-soon">Package manager coming in Phase 4.2!</p>
        </div>
        <div class="empty-state">
          <i class="fas fa-box-open"></i>
          <p>Save and manage your toast presentations</p>
          <small>Coming soon in v2.1.0</small>
        </div>
      </div>
    </div>

    {{!-- Studio Tab --}}
    <div class="tab-panel {{#if tabs.studio.active}}active{{/if}}" data-tab="studio">
      <div class="studio-container">
        <div class="studio-header">
          <h2>Presentation Studio</h2>
          <p class="coming-soon">Visual editor coming in Phase 4.4!</p>
        </div>
        <div class="empty-state">
          <i class="fas fa-palette"></i>
          <p>Create toasts visually with drag-and-drop</p>
          <small>Coming soon in v2.1.0</small>
        </div>
      </div>
    </div>
  </section>
</form>

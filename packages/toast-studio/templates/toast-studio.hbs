<form class="toast-studio-window">
  {{!-- Tab Navigation --}}
  <nav class="tabs" data-group="toast-studio-tabs">
    {{#each tabs}}
      <a class="item {{#if active}}active{{/if}} {{#if disabled}}disabled{{/if}}" data-tab="{{id}}">
        <i class="{{icon}}"></i> {{label}}
      </a>
    {{/each}}
  </nav>

  {{!-- Tab Content --}}
  <section class="tab-content">
    {{> modules/toast/templates/partials/assets-tab.hbs}}
    {{> modules/toast/templates/partials/packages-tab.hbs}}
    {{> modules/toast/templates/partials/animator-tab.hbs}}
  </section>
</form>

{{!-- Directories Sub-Tab - Manage asset source directories --}}
<div class="subtab-panel {{#if assetsSubTab.directories.active}}active{{/if}}" data-subtab="directories">
  <div class="directories-grid">

    {{!-- Default Directories Column --}}
    <div class="directory-column">
      <div class="directory-section">
        <h4><i class="fas fa-folder-open"></i> Default Directories</h4>
        <p class="section-description">Built-in module directories</p>
        {{#if directories.default.length}}
          {{#each directories.default}}
            {{> "modules/toast-studio/templates/partials/directory-item.hbs" readonly=true}}
          {{/each}}
        {{else}}
          {{> "modules/toast-studio/templates/partials/empty-state.hbs" icon="fas fa-folder" message="No default directories"}}
        {{/if}}
      </div>
    </div>

    {{!-- Announcer Packs Column --}}
    <div class="directory-column">
      <div class="directory-section">
        <h4><i class="fas fa-bullhorn"></i> Announcer Packs</h4>
        <p class="section-description">Registered by modules</p>
        {{#if directories.announcers.length}}
          {{#each directories.announcers}}
            {{> "modules/toast-studio/templates/partials/directory-item.hbs" readonly=true announcer=true}}
          {{/each}}
        {{else}}
          {{> "modules/toast-studio/templates/partials/empty-state.hbs" icon="fas fa-bullhorn" message="No packs registered" submessage="Modules can register via API"}}
        {{/if}}
      </div>
    </div>

    {{!-- Custom Directories Column --}}
    <div class="directory-column">
      <div class="directory-section">
        <h4><i class="fas fa-folder-plus"></i> Custom Directories</h4>
        <p class="section-description">Your asset directories</p>
        {{#if directories.custom.length}}
          {{#each directories.custom}}
            {{> "modules/toast-studio/templates/partials/directory-item.hbs" readonly=false custom=true}}
          {{/each}}
        {{else}}
          {{> "modules/toast-studio/templates/partials/empty-state.hbs" icon="fas fa-folder-plus" message="No custom directories" submessage="Add your directories below"}}
        {{/if}}

        {{!-- Add Directory Button --}}
        <button type="button" class="add-directory-btn">
          <i class="fas fa-plus"></i> Add Directory
        </button>
      </div>
    </div>

  </div>
</div>

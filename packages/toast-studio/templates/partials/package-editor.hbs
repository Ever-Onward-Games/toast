<form class="package-editor-form">
  <div class="form-sections">

    {{!-- Basic Information Section --}}
    <section class="form-section">
      <h3><i class="fas fa-info-circle"></i> Basic Information</h3>

      <div class="form-group">
        <label for="package-name">Package Name <span class="required">*</span></label>
        <input
          type="text"
          id="package-name"
          name="name"
          value="{{package.name}}"
          placeholder="My Awesome Toast"
          required
        />
      </div>

      <div class="form-group">
        <label for="package-description">Description</label>
        <textarea
          id="package-description"
          name="description"
          rows="3"
          placeholder="Describe what this package does..."
        >{{package.description}}</textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="package-version">Version</label>
          <input
            type="text"
            id="package-version"
            name="version"
            value="{{package.version}}"
            placeholder="1.0.0"
          />
        </div>

        <div class="form-group">
          <label for="package-author">Author</label>
          <input
            type="text"
            id="package-author"
            name="author"
            value="{{package.author}}"
            disabled
            title="Author is automatically set to the creator"
          />
        </div>
      </div>
    </section>

    {{!-- Organization Section --}}
    <section class="form-section">
      <h3><i class="fas fa-folder"></i> Organization</h3>

      <div class="form-row">
        <div class="form-group">
          <label for="package-category">Category</label>
          <select id="package-category" name="category">
            {{#each categories}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label for="package-scope">Scope</label>
          <select id="package-scope" name="scope">
            {{#each scopes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="package-tags">Tags <span class="help-text">(comma-separated)</span></label>
        <input
          type="text"
          id="package-tags"
          name="tags"
          value="{{tagsString}}"
          placeholder="critical-hit, combat, epic"
        />
      </div>

      <div class="form-group">
        <label for="package-thumbnail">Thumbnail Image</label>
        <div class="thumbnail-input-group">
          <input
            type="text"
            id="package-thumbnail"
            name="thumbnail"
            value="{{package.thumbnail}}"
            placeholder="modules/toast/images/..."
            readonly
          />
          <button type="button" class="thumbnail-picker">
            <i class="fas fa-folder-open"></i> Browse
          </button>
        </div>
        {{#if package.thumbnail}}
          <div class="thumbnail-preview">
            <img src="{{package.thumbnail}}" alt="Thumbnail preview" />
          </div>
        {{/if}}
      </div>
    </section>

    {{!-- Tokens Section --}}
    <section class="form-section">
      <h3>
        <i class="fas fa-code"></i> Token Placeholders
        <button type="button" class="add-token-btn btn-small">
          <i class="fas fa-plus"></i> Add Token
        </button>
      </h3>

      <p class="help-text">
        Tokens allow dynamic text replacement when launching the package. Use \{{tokenName}} syntax in text elements (e.g., "\{{playerName}} strikes!").
      </p>

      {{#if tokens.length}}
        <div class="tokens-list">
          {{#each tokens}}
            <div class="token-item">
              <div class="token-info">
                <strong>{{key}}</strong>
                <span class="token-label">{{label}}</span>
                {{#if defaultValue}}
                  <span class="token-default">(default: "{{defaultValue}}")</span>
                {{/if}}
              </div>
              <button type="button" class="remove-token-btn" data-token-key="{{key}}" title="Remove token">
                <i class="fas fa-times"></i>
              </button>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-state-small">
          <i class="fas fa-code"></i>
          <p>No tokens defined yet</p>
        </div>
      {{/if}}
    </section>

    {{!-- Elements Section --}}
    <section class="form-section">
      <h3>
        <i class="fas fa-film"></i> Animation Elements
        <button type="button" class="manage-elements-btn btn-small">
          <i class="fas fa-edit"></i> Manage
        </button>
      </h3>

      <div class="elements-summary">
        {{#if hasElements}}
          <div class="stat-box">
            <i class="fas fa-layer-group"></i>
            <strong>{{elementCount}}</strong> element{{#unless (eq elementCount 1)}}s{{/unless}}
          </div>
        {{else}}
          <div class="warning-box">
            <i class="fas fa-exclamation-triangle"></i>
            <p><strong>No elements yet!</strong> Use the <strong>Animator</strong> tab to create animations, or manually add elements.</p>
          </div>
        {{/if}}
      </div>
    </section>

  </div>

  {{!-- Footer Buttons --}}
  <footer class="form-footer">
    <button type="button" class="cancel-btn">
      <i class="fas fa-times"></i> Cancel
    </button>
    <button type="button" class="save-package-btn {{#unless canSave}}disabled{{/unless}}" {{#unless canSave}}disabled{{/unless}}>
      <i class="fas fa-save"></i> {{#if isNew}}Create Package{{else}}Save Changes{{/if}}
    </button>
  </footer>
</form>

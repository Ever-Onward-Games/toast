{
  "name": "toast-monorepo",
  "version": "3.0.0-beta.10",
  "description": "Toast monorepo - Player and Studio modules for Foundry VTT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node build-monorepo.js",
    "build:production": "node build-monorepo.js --production",
    "build:player": "node build-monorepo.js --package=toast-player",
    "build:studio": "node build-monorepo.js --package=toast-studio",
    "build:zip": "node build-monorepo.js && node build-zip-monorepo.js",
    "build:zip:version": "node build-monorepo.js && node build-zip-monorepo.js --version",
    "build:release": "node build-monorepo.js --production && node build-zip-monorepo.js --version",
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); const dir=path.join(__dirname,'dist'); if(fs.existsSync(dir)){fs.rmSync(dir,{recursive:true}); console.log('✅ Cleaned dist/');}\"",
    "test": "echo \"No tests configured\" && exit 0",
    "version:sync": "node scripts/sync-versions.js",
    "version:bump-beta": "node scripts/bump-beta.js",
    "docs:sync": "node scripts/sync-manifests-to-docs.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ever-Onward-Games/toast.git"
  },
  "keywords": [
    "foundry-vtt",
    "foundryvtt",
    "module",
    "toast",
    "celebration",
    "notifications"
  ],
  "author": "Dynvar",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.93.2"
  },
  "optionalDependencies": {
    "archiver": "^6.0.0"
  }
}
